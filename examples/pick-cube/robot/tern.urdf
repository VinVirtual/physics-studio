<?xml version="1.0"?>
<!-- Tern: a small five-joint arm with a two-finger gripper, written for physics-studio from boxes and
     cylinders. Not a real product. MIT licence, like the rest of this repository.
     Joints: base_yaw, shoulder, elbow, wrist_pitch, wrist_roll; fingers: finger_left, finger_right. -->
<robot name="tern">
  <link name="base_link">
    <inertial><origin xyz="0 0 0.03"/><mass value="2.0"/>
      <inertia ixx="0.003" iyy="0.003" izz="0.005" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.03"/><geometry><cylinder radius="0.075" length="0.06"/></geometry></collision>
  </link>

  <link name="turret">
    <inertial><origin xyz="0 0 0.04"/><mass value="0.6"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0008" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.05" length="0.08"/></geometry></collision>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/><child link="turret"/>
    <origin xyz="0 0 0.06"/><axis xyz="0 0 1"/>
    <limit lower="-2.9" upper="2.9" effort="3" velocity="2.5"/>
    <dynamics damping="0.2"/>
  </joint>

  <link name="upper_arm">
    <inertial><origin xyz="0 0 0.11"/><mass value="0.45"/>
      <inertia ixx="0.0019" iyy="0.0019" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.11"/><geometry><box size="0.05 0.055 0.25"/></geometry></collision>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="turret"/><child link="upper_arm"/>
    <origin xyz="0 0 0.09"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="6" velocity="2.5"/>
    <dynamics damping="0.2"/>
  </joint>

  <link name="forearm">
    <inertial><origin xyz="0 0 0.1"/><mass value="0.32"/>
      <inertia ixx="0.0011" iyy="0.0011" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.1"/><geometry><box size="0.04 0.045 0.22"/></geometry></collision>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.22"/><axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="4" velocity="3"/>
    <dynamics damping="0.15"/>
  </joint>

  <link name="wrist">
    <inertial><origin xyz="0 0 0.03"/><mass value="0.15"/>
      <inertia ixx="0.00008" iyy="0.00008" izz="0.00004" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.03"/><geometry><box size="0.035 0.04 0.06"/></geometry></collision>
  </link>
  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm"/><child link="wrist"/>
    <origin xyz="0 0 0.2"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="1.5" velocity="3"/>
    <dynamics damping="0.08"/>
  </joint>

  <link name="palm">
    <inertial><origin xyz="0 0 0.012"/><mass value="0.12"/>
      <inertia ixx="0.00005" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.012"/><geometry><box size="0.1 0.035 0.024"/></geometry></collision>
  </link>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist"/><child link="palm"/>
    <origin xyz="0 0 0.06"/><axis xyz="0 0 1"/>
    <limit lower="-3.1" upper="3.1" effort="1" velocity="3"/>
    <dynamics damping="0.05"/>
  </joint>

  <link name="finger_left_link">
    <inertial><origin xyz="0 0 0.035"/><mass value="0.03"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.000004" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.035"/><geometry><box size="0.012 0.03 0.06"/></geometry></collision>
  </link>
  <joint name="finger_left" type="prismatic">
    <parent link="palm"/><child link="finger_left_link"/>
    <origin xyz="0 0 0.024"/><axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.042" effort="12" velocity="0.2"/>
    <dynamics damping="1.0"/>
  </joint>

  <link name="finger_right_link">
    <inertial><origin xyz="0 0 0.035"/><mass value="0.03"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.000004" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0.035"/><geometry><box size="0.012 0.03 0.06"/></geometry></collision>
  </link>
  <joint name="finger_right" type="prismatic">
    <parent link="palm"/><child link="finger_right_link"/>
    <origin xyz="0 0 0.024"/><axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.042" effort="12" velocity="0.2"/>
    <dynamics damping="1.0"/>
  </joint>
</robot>
